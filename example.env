# Copy to ".env" in the repository root and edit values.
# Load into your shell (see scripts/bake-env.*), then run uvicorn or uv run.
#
#   cp example.env .env
#   source scripts/bake-env.sh          # bash / zsh / Git Bash on Windows
#   . .\scripts\bake-env.ps1            # PowerShell
#
# To snapshot vars you already exported in this shell into .env:
#   uv run python scripts/capture_env_to_dotenv.py

# --- Backend API (required for scorer_v2 + MFA) ---
PRONUNCIATION_USE_HF_ENCODER=1
PRONUNCIATION_BACKBONE_ID=facebook/hubert-base-ls960
PRONUNCIATION_DEVICE=cuda
PRONUNCIATION_SCORER_DEVICE=cuda
PRONUNCIATION_SCORER_STRICT_LOAD=1
PRONUNCIATION_SCORER_CHECKPOINT_PATH=/path/to/scorer_v2_best.pt

PRONUNCIATION_RUNTIME_BACKEND=scorer_v2
PRONUNCIATION_ALIGNER_BACKEND=mfa

# MFA: command must resolve to an MFA executable or a launcher (e.g. micromamba run -n mfa mfa).
# Linux example:
# PRONUNCIATION_MFA_COMMAND=/opt/micromamba/bin/micromamba run -n mfa mfa
# Windows example (adjust path):
# PRONUNCIATION_MFA_COMMAND=C:/Users/You/micromamba/micromamba.exe run -n mfa mfa
PRONUNCIATION_MFA_COMMAND=
PRONUNCIATION_MFA_ACOUSTIC_MODEL=english_us_arpa
PRONUNCIATION_MFA_TIMEOUT_SECONDS=30

# Optional: pin a local CMUdict file instead of the bundled cmudict package data.
# PRONUNCIATION_CMUDICT_PATH=/cold/pronunciation/resources/cmudict/cmudict-0.7b

# Storage (override if not using /cold layout)
PRONUNCIATION_STORAGE_ROOT=/cold/pronunciation
PRONUNCIATION_MFA_WORK_ROOT=/cold/pronunciation/runtime/mfa
PRONUNCIATION_DATASET_ROOT=/cold/pronunciation/datasets
PRONUNCIATION_FEATURE_ROOT=/cold/pronunciation/features
PRONUNCIATION_CHECKPOINT_ROOT=/cold/pronunciation/checkpoints
PRONUNCIATION_REPORT_ROOT=/cold/pronunciation/reports
HF_HOME=/cold/huggingface

# --- Demo frontend (optional; py -m pronunciation_backend.frontend) ---
PRONUNCIATION_FRONTEND_HOST=127.0.0.1
PRONUNCIATION_FRONTEND_PORT=3000
PRONUNCIATION_FRONTEND_BACKEND_URL=http://127.0.0.1:8000
