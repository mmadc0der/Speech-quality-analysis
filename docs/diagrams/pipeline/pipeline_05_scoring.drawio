        <mxCell id="s1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="pred" target="conf"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="pred" target="overall"><mxGeometry relative="1" as="geometry" /></mxCell>
