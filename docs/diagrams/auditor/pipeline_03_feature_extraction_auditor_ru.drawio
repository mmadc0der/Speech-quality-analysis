<mxfile host="app.diagrams.net" version="24.0.0">
  <diagram id="features_auditor" name="Признаки и сопоставление">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1120" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Извлечение признаков речи и сопоставление со звуками слова" style="text;html=1;align=center;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="160" y="20" width="800" height="40" as="geometry" />
        </mxCell>

        <mxCell id="in" value="Подготовленный звук" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fbff;strokeColor=#6b9df2;fontColor=#0b2545;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="430" y="90" width="280" height="60" as="geometry" />
        </mxCell>

        <mxCell id="word" value="Ожидаемое слово&#10;и его звуки (по порядку)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf4ff;strokeColor=#2f80ed;fontColor=#0b2545;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="60" y="430" width="280" height="80" as="geometry" />
        </mxCell>

        <mxCell id="encoder" value="Нейросеть превращает речь&#10;в числовое представление&#10;(признаки по коротким отрезкам звука)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2ebff;strokeColor=#7b61ff;fontColor=#24123d;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="420" y="220" width="300" height="100" as="geometry" />
        </mxCell>

        <mxCell id="align" value="Сопоставление звука&#10;с ожидаемыми звуками слова&#10;(определение границ каждого звука)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4d6;strokeColor=#f2a900;fontColor=#3d2c00;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="410" y="410" width="320" height="100" as="geometry" />
        </mxCell>

        <mxCell id="avg" value="Усреднение признаков&#10;в пределах каждого звука" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2ebff;strokeColor=#7b61ff;fontColor=#24123d;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="420" y="590" width="300" height="80" as="geometry" />
        </mxCell>

        <mxCell id="out" value="Готовые данные для модели:&#10;признаки по каждому звуку&#10;и ожидаемые звуки слова" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fbff;strokeColor=#6b9df2;fontColor=#0b2545;fontSize=14;" vertex="1" parent="1">
