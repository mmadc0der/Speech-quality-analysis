        </mxCell>

        <mxCell id="ea" value="подготовленный звук" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="in" target="encoder"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eb" value="признаки по отрезкам звука" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="encoder" target="align"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ec" value="ожидаемые звуки по порядку" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="word" target="align"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ed" value="границы каждого звука" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="align" target="avg"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ehb" value="признаки по отрезкам звука" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="encoder" target="avg"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="800" y="270" /><mxPoint x="800" y="630" /></Array></mxGeometry></mxCell>
        <mxCell id="ee" value="признаки по каждому звуку" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="avg" target="out"><mxGeometry relative="1" as="geometry" /></mxCell>
