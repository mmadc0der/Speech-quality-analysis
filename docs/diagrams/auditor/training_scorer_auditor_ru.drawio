<mxfile host="app.diagrams.net" version="24.0.0">
  <diagram id="scorer_train_auditor" name="Обучение оценщика">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="780" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Как учится нейросеть-оценщик произношения" style="text;html=1;align=center;fontSize=22;fontStyle=1;fontColor=#0b2545;" vertex="1" parent="1">
          <mxGeometry x="100" y="24" width="1600" height="40" as="geometry" />
        </mxCell>

        <!-- INPUT CARD -->
        <mxCell id="in_card" value="Обучающий пример (подготовленный)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=#eaf4ff;strokeColor=#2f80ed;fontColor=#0b2545;fontSize=15;fontStyle=1;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="140" width="380" height="270" as="geometry" />
        </mxCell>
        <mxCell id="in_i1" value="Звуковые признаки по звукам слова" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2f80ed;fontColor=#0b2545;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="85" y="205" width="330" height="56" as="geometry" />
        </mxCell>
        <mxCell id="in_i2" value="Ожидаемые звуки слова" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2f80ed;fontColor=#0b2545;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="85" y="275" width="330" height="56" as="geometry" />
        </mxCell>
        <mxCell id="in_i3" value="Маска значимых звуков" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2f80ed;fontColor=#0b2545;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="85" y="345" width="330" height="50" as="geometry" />
        </mxCell>

        <!-- MODEL -->
        <mxCell id="model" value="Нейросеть-оценщик&#10;произношения" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f8ee;strokeColor=#27ae60;fontColor=#0f3b22;fontSize=20;fontStyle=1;arcSize=8;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="640" y="215" width="340" height="160" as="geometry" />
        </mxCell>

        <!-- OUTPUT CARD -->
        <mxCell id="out_card" value="Результат модели" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=#fff4e0;strokeColor=#f2a900;fontColor=#3d2c00;fontSize=15;fontStyle=1;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="1180" y="140" width="420" height="270" as="geometry" />
        </mxCell>
        <mxCell id="out_i1" value="Вероятности качества по каждому звуку:&#10;неверно / с акцентом / верно" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#f2a900;fontColor=#3d2c00;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1205" y="205" width="370" height="66" as="geometry" />
        </mxCell>
        <mxCell id="out_i2" value="Признак пропуска звука" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#f2a900;fontColor=#3d2c00;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1205" y="285" width="370" height="50" as="geometry" />
        </mxCell>
        <mxCell id="out_i3" value="Итоговая оценка произношения" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#f2a900;fontColor=#3d2c00;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1205" y="349" width="370" height="50" as="geometry" />
        </mxCell>

        <!-- input -> model -->
        <mxCell id="e_in" value="подаётся на вход" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2.5;strokeColor=#2f80ed;fontColor=#0b2545;fontSize=13;" edge="1" parent="1" source="in_card" target="model"><mxGeometry relative="1" as="geometry" /></mxCell>
        <!-- model -> output -->
        <mxCell id="e_out" value="выдаёт" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2.5;strokeColor=#27ae60;fontColor=#0f3b22;fontSize=13;" edge="1" parent="1" source="model" target="out_card"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- LOSS SECTION HEADER -->
        <mxCell id="loss_h" value="Расчёт ошибки (потерь): результат сравнивается с правильными ответами" style="text;html=1;align=center;fontSize=16;fontStyle=1;fontColor=#7a1f3d;" vertex="1" parent="1">
          <mxGeometry x="100" y="455" width="1600" height="30" as="geometry" />
        </mxCell>

        <!-- LABELS CARD -->
        <mxCell id="lab_card" value="Правильные ответы (разметка)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=#f4e9ff;strokeColor=#7b61ff;fontColor=#24123d;fontSize=15;fontStyle=1;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="1180" y="510" width="420" height="190" as="geometry" />
        </mxCell>
        <mxCell id="lab_i1" value="Эталонные оценки звуков" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7b61ff;fontColor=#24123d;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1205" y="570" width="370" height="50" as="geometry" />
        </mxCell>
        <mxCell id="lab_i2" value="Отметка пропусков звуков" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7b61ff;fontColor=#24123d;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1205" y="634" width="370" height="50" as="geometry" />
        </mxCell>

        <!-- COMPARISON -->
        <mxCell id="cmp" value="Сравнение результата модели&#10;с правильными ответами" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde8ee;strokeColor=#c0395f;fontColor=#7a1f3d;fontSize=14;fontStyle=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="640" y="545" width="340" height="110" as="geometry" />
        </mxCell>

        <!-- ERRORS -->
        <mxCell id="err_q" value="Ошибка качества" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde8ee;strokeColor=#c0395f;fontColor=#7a1f3d;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="370" y="520" width="210" height="64" as="geometry" />
        </mxCell>
        <mxCell id="err_o" value="Ошибка пропусков" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde8ee;strokeColor=#c0395f;fontColor=#7a1f3d;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="370" y="616" width="210" height="64" as="geometry" />
        </mxCell>
        <mxCell id="err_total" value="Итоговая ошибка" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c0395f;strokeColor=#7a1f3d;fontColor=#ffffff;fontSize=15;fontStyle=1;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="120" y="556" width="190" height="88" as="geometry" />
        </mxCell>

        <!-- loss edges -->
        <mxCell id="le1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;strokeColor=#f2a900;" edge="1" parent="1" source="out_card" target="cmp"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="le2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;strokeColor=#7b61ff;" edge="1" parent="1" source="lab_card" target="cmp"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="le3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;strokeColor=#c0395f;" edge="1" parent="1" source="cmp" target="err_q"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="le4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;strokeColor=#c0395f;" edge="1" parent="1" source="cmp" target="err_o"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="le5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;strokeColor=#c0395f;" edge="1" parent="1" source="err_q" target="err_total"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="le6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;strokeColor=#c0395f;" edge="1" parent="1" source="err_o" target="err_total"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- update weights back to model -->
        <mxCell id="le7" value="обновление весов (обучение)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=3;strokeColor=#27ae60;fontColor=#0f3b22;fontSize=13;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="err_total" target="model"><mxGeometry relative="1" as="geometry" /></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
