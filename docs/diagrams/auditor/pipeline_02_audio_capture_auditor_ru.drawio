        <mxCell id="ep4" value="запись пригодна к анализу" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4" target="out"><mxGeometry relative="1" as="geometry" /></mxCell>
