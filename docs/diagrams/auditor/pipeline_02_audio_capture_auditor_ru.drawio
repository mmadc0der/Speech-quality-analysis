<mxfile host="app.diagrams.net" version="24.0.0">
  <diagram id="capture_auditor" name="Запись и подготовка звука">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="720" math="0" shadow="0">
      <root>
