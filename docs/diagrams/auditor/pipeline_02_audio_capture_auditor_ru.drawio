        <mxCell id="p2" value="Выравнивание громкости&#10;до единого уровня" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7b61ff;fontSize=13;" vertex="1" parent="1">
