        <mxCell id="p1" value="Приведение к единому формату:&#10;один звуковой канал и единая частота" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7b61ff;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="640" y="160" width="420" height="80" as="geometry" />
