<mxfile host="app.diagrams.net" version="24.0.0">
  <diagram id="encoder_pretrain_auditor" name="Предобучение кодировщика">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1840" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Как кодировщик учится сам: восстановление скрытых отрезков речи" style="text;html=1;align=center;fontSize=22;fontStyle=1;fontColor=#0b2545;" vertex="1" parent="1">
          <mxGeometry x="80" y="20" width="1680" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Самообучение: разметка человека и проверочная выборка не нужны — кодировщик учится восстанавливать сам себя" style="text;html=1;align=center;fontSize=15;fontStyle=2;fontColor=#7a1f3d;" vertex="1" parent="1">
          <mxGeometry x="80" y="66" width="1680" height="28" as="geometry" />
        </mxCell>

        <!-- ===== INPUT CARD ===== -->
        <mxCell id="in_card" value="Подготовленные данные (без меток)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=#eaf4ff;strokeColor=#2f80ed;fontColor=#0b2545;fontSize=15;fontStyle=1;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="130" width="360" height="250" as="geometry" />
        </mxCell>
        <mxCell id="in_i1" value="Признаки речи по отрезкам — числовое представление звука по кадрам" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2f80ed;fontColor=#0b2545;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="185" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="in_i2" value="Множество записей речи без оценок и без разметки человека" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2f80ed;fontColor=#0b2545;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="280" width="320" height="80" as="geometry" />
        </mxCell>

        <!-- ===== MASKING CARD ===== -->
        <mxCell id="mask_card" value="Часть отрезков скрывается (маскируется)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=#fff4e0;strokeColor=#f2a900;fontColor=#3d2c00;fontSize=15;fontStyle=1;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="460" y="130" width="400" height="250" as="geometry" />
        </mxCell>
        <mxCell id="seg1" value="виден" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f8ee;strokeColor=#27ae60;fontColor=#0f3b22;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="478" y="195" width="58" height="56" as="geometry" />
        </mxCell>
        <mxCell id="seg2" value="скрыт" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#eceff1;strokeColor=#90a4ae;fontColor=#546e7a;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="540" y="195" width="58" height="56" as="geometry" />
        </mxCell>
        <mxCell id="seg3" value="виден" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f8ee;strokeColor=#27ae60;fontColor=#0f3b22;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="602" y="195" width="58" height="56" as="geometry" />
        </mxCell>
        <mxCell id="seg4" value="виден" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f8ee;strokeColor=#27ae60;fontColor=#0f3b22;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="664" y="195" width="58" height="56" as="geometry" />
        </mxCell>
        <mxCell id="seg5" value="скрыт" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#eceff1;strokeColor=#90a4ae;fontColor=#546e7a;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="726" y="195" width="58" height="56" as="geometry" />
        </mxCell>
        <mxCell id="seg6" value="виден" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f8ee;strokeColor=#27ae60;fontColor=#0f3b22;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="788" y="195" width="58" height="56" as="geometry" />
        </mxCell>
        <mxCell id="mask_note" value="Скрытые отрезки кодировщик не видит — их предстоит восстановить" style="text;html=1;align=center;fontSize=12;fontStyle=2;fontColor=#3d2c00;" vertex="1" parent="1">
          <mxGeometry x="478" y="270" width="368" height="90" as="geometry" />
        </mxCell>

        <!-- ===== ENCODER ===== -->
        <mxCell id="enc" value="Кодировщик&#10;(нейросеть-кодировщик)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=#e6f8ee;strokeColor=#27ae60;fontColor=#0f3b22;fontSize=20;fontStyle=1;arcSize=8;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="920" y="150" width="340" height="210" as="geometry" />
        </mxCell>
        <mxCell id="enc_note" value="Восстанавливает скрытое, опираясь на соседние видимые отрезки (контекст)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#27ae60;fontColor=#0f3b22;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="945" y="240" width="290" height="100" as="geometry" />
        </mxCell>

        <!-- ===== RECONSTRUCT OUTPUT ===== -->
        <mxCell id="rec_card" value="Восстановленные отрезки" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=#fff4e0;strokeColor=#f2a900;fontColor=#3d2c00;fontSize=15;fontStyle=1;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="1320" y="130" width="470" height="250" as="geometry" />
        </mxCell>
        <mxCell id="rec_i1" value="Кодировщик заполняет скрытые отрезки своими предсказаниями" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#f2a900;fontColor=#3d2c00;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1345" y="195" width="420" height="80" as="geometry" />
        </mxCell>
        <mxCell id="rec_i2" value="Предсказанные значения сравниваются с настоящими скрытыми отрезками" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#f2a900;fontColor=#3d2c00;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1345" y="290" width="420" height="74" as="geometry" />
        </mxCell>

        <!-- row 1 edges -->
        <mxCell id="e_in_mask" value="берутся признаки" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2.5;strokeColor=#2f80ed;fontColor=#0b2545;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="in_card" target="mask_card"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_mask_enc" value="последовательность с пропусками" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2.5;strokeColor=#f2a900;fontColor=#3d2c00;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="mask_card" target="enc"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_enc_rec" value="предсказание скрытого" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2.5;strokeColor=#27ae60;fontColor=#0f3b22;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="enc" target="rec_card"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ===== LOSS SECTION ===== -->
        <mxCell id="loss_h" value="Цикл обучения: восстановить → сравнить с исходным → обновить веса" style="text;html=1;align=center;fontSize=16;fontStyle=1;fontColor=#7a1f3d;" vertex="1" parent="1">
          <mxGeometry x="80" y="540" width="1680" height="30" as="geometry" />
        </mxCell>

        <!-- original hidden values -->
        <mxCell id="orig_card" value="Исходные значения скрытых отрезков" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=#f4e9ff;strokeColor=#7b61ff;fontColor=#24123d;fontSize=14;fontStyle=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="460" y="600" width="400" height="140" as="geometry" />
        </mxCell>
        <mxCell id="orig_i" value="Настоящие значения отрезков до того, как их скрыли" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7b61ff;fontColor=#24123d;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="485" y="650" width="350" height="70" as="geometry" />
        </mxCell>

        <!-- compare -->
        <mxCell id="cmp" value="Сравнение восстановленного&#10;с исходным" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde8ee;strokeColor=#c0395f;fontColor=#7a1f3d;fontSize=14;fontStyle=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="920" y="600" width="340" height="140" as="geometry" />
        </mxCell>

        <!-- error -->
        <mxCell id="err" value="Ошибка восстановления&#10;(насколько предсказание&#10;отличается от исходного)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c0395f;strokeColor=#7a1f3d;fontColor=#ffffff;fontSize=14;fontStyle=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="1380" y="600" width="360" height="140" as="geometry" />
        </mxCell>

        <!-- loss edges -->
        <mxCell id="le_rec_cmp" value="восстановленные значения" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;strokeColor=#f2a900;fontColor=#3d2c00;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="rec_card" target="cmp"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="le_orig_cmp" value="исходные значения" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;strokeColor=#7b61ff;fontColor=#24123d;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="orig_card" target="cmp"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="le_cmp_err" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;strokeColor=#c0395f;" edge="1" parent="1" source="cmp" target="err"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- update weights feedback to encoder -->
        <mxCell id="le_update" value="обновление весов (обучение)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=3;strokeColor=#27ae60;fontColor=#0f3b22;fontSize=13;dashed=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="err" target="enc"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ===== FINAL WEIGHTS ===== -->
        <mxCell id="final_card" value="Готовые веса кодировщика" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=#e6f8ee;strokeColor=#1e8449;fontColor=#0f3b22;fontSize=15;fontStyle=1;arcSize=8;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="600" width="360" height="160" as="geometry" />
        </mxCell>
        <mxCell id="final_i" value="После многих повторов цикла передаются в обучение нейросети-оценщика произношения" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e8449;fontColor=#0f3b22;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="650" width="320" height="90" as="geometry" />
        </mxCell>
        <mxCell id="e_enc_final" value="по завершении предобучения" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2.5;strokeColor=#1e8449;fontColor=#0f3b22;fontSize=12;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="enc" target="final_card"><mxGeometry relative="1" as="geometry" /></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
